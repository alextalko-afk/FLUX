# Copy to .env.prod and fill in EVERY value. Generate secrets with: openssl rand -hex 32
DOMAIN=chat.example.com
ACME_EMAIL=admin@example.com

POSTGRES_USER=flux
POSTGRES_PASSWORD=
POSTGRES_DB=flux
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Server secrets (see .env.example for the full list and descriptions)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
METRICS_TOKEN=
PASSCODE_PEPPER=

# Optional: group calls (--profile calls)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: monitoring (--profile monitoring)
GRAFANA_PASSWORD=
