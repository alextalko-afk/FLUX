# DATABASE & CACHE
DATABASE_URL="postgresql://tguser:tgpass@localhost:5432/tglike?schema=public"
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# SECURITY & AUTH
JWT_ACCESS_SECRET="replace_with_strong_random_string_32_chars"
JWT_REFRESH_SECRET="replace_with_another_strong_random_string"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
PASSCODE_PEPPER="replace_with_pepper_string"

# STORAGE (MinIO / S3)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_BUCKET_AVATARS="avatars"
S3_BUCKET_MEDIA="chat-media"
S3_BUCKET_VOICE="voice"
S3_BUCKET_VIDEO="video"
S3_BUCKET_STICKERS="stickers"
S3_BUCKET_EXPORTS="exports"
S3_BUCKET_TEMP="temp"
S3_FORCE_PATH_STYLE="true"

# WEB PUSH (VAPID)
VAPID_SUBJECT="mailto:admin@tg-like.local"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# WEBRTC / TURN
TURN_SERVER_URL="turn:localhost:3478"
TURN_USERNAME="tglike"
TURN_CREDENTIAL="tglike_secret_turn_credential"
STUN_SERVER_URL="stun:stun.l.google.com:19302"

# SERVER CONFIG
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
API_PREFIX="/api/v1"
WS_PATH="/ws"
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
# Number of reverse proxies in front of the API (nginx = 1). Needed so per-IP
# rate limits see the real client address; leave 0 when the API is exposed directly.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# E-MAIL (verification, password reset and sign-in codes)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty to run without a mail provider: outside production the
# codes are written to the server log. For local testing start Mailpit
# (`docker compose --profile mail up -d mailpit`) and use SMTP_HOST=localhost,
# SMTP_PORT=1025; its inbox is at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465). Otherwise STARTTLS is negotiated when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FLUX <no-reply@example.com>"

# Require two-factor sign-in for administrators before the admin API answers (set 1 in production)
ADMIN_REQUIRE_2FA=0

# Virus scanning of uploads through ClamAV (docker compose --profile antivirus up -d clamav). Empty host = off.
CLAMAV_HOST=
CLAMAV_PORT=3310
# 1 = refuse uploads when the scanner cannot be reached (recommended in production)
CLAMAV_REQUIRED=0

# --- FFmpeg (video posters, measured media duration) --------------------------
# Optional. When the binaries are not found the features switch themselves off.
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_TIMEOUT_MS=30000

# --- Group calls (LiveKit SFU) ------------------------------------------------
# Leave empty to switch group calls off. Start LiveKit with
# `docker compose --profile calls up -d livekit` and use the same key pair there.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GROUP_CALL_MAX_PARTICIPANTS=50

# --- Mobile push ---------------------------------------------------------------
# Expo tokens need no credentials (set EXPO_ACCESS_TOKEN only if "enhanced push security" is on).
EXPO_ACCESS_TOKEN=
# Raw FCM tokens: the Firebase service account JSON (the JSON itself or a path to the file).
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# --- Metrics (Prometheus) ------------------------------------------------------
# GET /api/v1/metrics answers only with `Authorization: Bearer <METRICS_TOKEN>`; empty switches it off.
METRICS_TOKEN=

# --- Object storage, public address -------------------------------------------
# Presigned upload/download links are signed for, and opened by, the browser. Behind a reverse proxy set
# this to the public URL of the S3 endpoint (for example https://s3.example.com); empty = same as S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# Message translation (LibreTranslate-compatible API). Empty: the Translate menu item answers "not configured".
TRANSLATE_URL=
TRANSLATE_API_KEY=

# Voice-message transcription (OpenAI-compatible /audio/transcriptions). Empty: disabled.
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# Dev only: the address LiveKit advertises to browsers (the docker-published ports on this machine).
# LIVEKIT_NODE_IP=127.0.0.1
